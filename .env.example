# Copy to .env and fill in. Never commit .env. The repo is public.
# Intern reads its own copy of these from ~/.intern/.env.

# Nace AI console key (nace_sk_...): Drex (steering), NDI (documents), and Intern's System 1.
NACE_API_KEY=

# DeepInfra: the large-model baseline, the small judge models, and the model inside Intern.
DEEPINFRA_API_KEY=

# Keenable: web research.
KEENABLE_API_KEY=

# OpenAI (optional secondary baseline; skipped when empty).
OPENAI_API_KEY=

# Any OpenAI-compatible server (optional): self-hosted vLLM / SGLang / Ollama on your own GPU,
# OpenRouter, Together, DeepInfra... Base URL without /chat/completions. The key may be empty for
# local servers. Use it as provider "openai_compatible" (e.g. --blue openai_compatible).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# Google Gemini (optional; skipped when empty).
GEMINI_API_KEY=

# Shared secret for the server's /api/admin/* routes.
ADMIN_TOKEN=
