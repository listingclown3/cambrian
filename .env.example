# Copy to .env and fill in. Never commit .env.

# Nace AI (Drex). Format: nace_sk_... Used by the "drex" provider.
NACE_API_KEY=

# Anthropic. Used by the "claude" provider.
ANTHROPIC_API_KEY=

# OpenAI. Used by the "openai" provider.
OPENAI_API_KEY=

# Google Gemini (optional). Used by the "gemini" provider.
GEMINI_API_KEY=

# Shared secret for the server's /api/admin/* routes (start/stop runs from the UI).
ADMIN_TOKEN=
