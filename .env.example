# Copy to .env and fill in. Never commit .env. The repo is public.
# Intern reads its own copy of these from ~/.intern/.env.

# Nace AI console key (nace_sk_...): Drex (System 1), NDI, and Intern's System 1.
NACE_API_KEY=

# DeepInfra: the System 2 baseline, and the model inside Intern.
DEEPINFRA_API_KEY=

# Keenable: web research.
KEENABLE_API_KEY=

# OpenAI (optional secondary baseline; skipped when empty).
OPENAI_API_KEY=

# Google Gemini (optional; skipped when empty).
GEMINI_API_KEY=

# Shared secret for the server's /api/admin/* routes.
ADMIN_TOKEN=
