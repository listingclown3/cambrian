{
  "name": "cambrian",
  "private": true,
  "version": "0.0.0",
  "description": "Cambrian: guided quirk discovery. Cheap models steer a search for unintended behaviours in a simulated world, archive them as a graph and chain them into strategies. First world: FRC REBUILT 2026.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "keys": "tsx src/util/keycheck.ts",
    "match": "tsx src/world/worlds/rebuilt/exec/playMatch.ts",
    "research": "tsx src/history/research/research.ts",
    "ingest": "tsx src/history/ingest/ingest.ts",
    "quirks": "tsx src/search/proposals/quirks.ts",
    "archive": "tsx src/archive/seed.ts",
    "explore": "tsx experiments/nace-2026/bench/benchExplore.ts",
    "lab": "tsx src/search/proposals/main.ts",
    "usage": "tsx src/ledger/cli.ts",
    "prepush": "node scripts/prepush.mjs",
    "history:rules": "tsx src/history/ingest/manualRules.ts",
    "history:pages": "tsx src/history/ingest/pages.ts",
    "history:conduct": "tsx src/history/ingest/conductRules.ts",
    "history:judge": "tsx src/history/ingest/ruleJudge.ts",
    "history:scouting-gen": "tsx src/history/ingest/scoutingGen.ts",
    "history:scouting": "tsx src/history/ingest/scoutingExtract.ts",
    "world:bench-engine": "tsx src/world/worlds/rebuilt/exec/benchEngine.ts",
    "world:field-build": "tsx src/world/worlds/rebuilt/field/build.ts",
    "world:field-extract": "tsx src/world/worlds/rebuilt/field/extract.ts",
    "steer:smoke": "tsx src/search/steer/smoke.ts",
    "steer:match": "tsx src/search/steer/agentMatch.ts",
    "steer:models": "tsx src/util/drexModels.ts",
    "proposals:sim": "tsx src/search/proposals/labSim.ts",
    "proposals:rulescan": "tsx src/search/proposals/ruleScan.ts",
    "proposals:intern-task": "tsx src/search/proposals/internTask.ts",
    "server:record-fixture": "tsx src/server/recordFixture.ts",
    "server:record-scenarios": "tsx src/server/recordScenarios.ts",
    "ledger:merge": "node scripts/merge-ledgers.mjs",
    "nace:batch": "tsx experiments/nace-2026/bench/benchBatch.ts",
    "nace:hosts": "tsx experiments/nace-2026/bench/hostCompare.ts",
    "nace:league": "tsx experiments/nace-2026/bench/league.ts",
    "nace:matches": "tsx experiments/nace-2026/bench/matches.ts",
    "nace:mine": "tsx experiments/nace-2026/bench/mine.ts",
    "nace:families": "tsx experiments/nace-2026/bench/families.ts",
    "nace:answerkey": "tsx experiments/nace-2026/bench/answerkey.ts",
    "nace:rekey": "tsx experiments/nace-2026/bench/rekey.ts",
    "nace:leaktest": "tsx experiments/nace-2026/bench/leakTest.ts",
    "nace:final": "tsx experiments/nace-2026/bench/finalRun.ts",
    "nace:chain": "pnpm nace:answerkey -- --in base_scenarios.json --rollouts 100 --horizon end --out scenarios.json --results answerkey && pnpm nace:scenarios -- --rescore && pnpm explore && pnpm nace:headline",
    "nace:scenarios": "tsx experiments/nace-2026/bench/benchScenarios.ts",
    "nace:myrobot": "tsx experiments/nace-2026/bench/benchMyRobot.ts",
    "nace:live": "tsx experiments/nace-2026/bench/benchLive.ts",
    "nace:headline": "tsx experiments/nace-2026/bench/headline.ts",
    "nace:idle": "tsx experiments/nace-2026/bench/idleReport.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "p-limit": "^7.3.3",
    "pure-rand": "^8.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tinypool": "^2.2.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "license": "MIT"
}
